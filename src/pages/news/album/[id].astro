---
import Base from '../../../layouts/Base.astro';
import Paragraphs from '../../../components/Paragraphs.astro';
import { getContent, fmtFull, driveImg, type Album } from '../../../lib/content';
import { nextgen } from '../../../data/church';

export async function getStaticPaths() {
  const { albums } = await getContent();
  return albums.map((album) => ({ params: { id: album.id }, props: { album } }));
}

const { album } = Astro.props as { album: Album };
const driveImgWide = (id: string) => driveImg(id, 2400);
// 소개글의 "[사진]" 자리마다 사진을 고르게 나눠 넣는다. 표시가 없으면 글은 모두 맨 위에 둔다.
const [intro = [], ...after] = album.parts;
const groups = after.length || 1;
const per = Math.ceil(album.photos.length / groups);
const chunks = Array.from({ length: groups }, (_, i) => album.photos.slice(i * per, (i + 1) * per));
const back = album.dept ? { href: `/nextgen/${album.dept}/`, label: `${nextgen[album.dept].title} 이야기` } : { href: '/news/album/', label: '교회앨범' };
---
<Base title={album.title} description={album.text[0]?.slice(0, 120)}>
  <div class="wrap head">
    <a class="back" href={back.href}>← {back.label}</a>
    <span class="eyebrow date">{fmtFull(album.date)}</span>
    <h1>{album.title}</h1>
    {intro.length > 0 && <Paragraphs paras={intro} />}
  </div>
  <section class="wrap gallery">
    {album.lead && (
      album.lead.video
        ? <button class="lead item video" data-src={album.lead.src} data-embed={album.lead.embed} aria-label="영상 재생"><img class="cover" src={album.lead.thumb} alt="" /><span class="play" aria-hidden="true"></span></button>
        : <a class="lead item photo" href={album.lead.src} target="_blank" rel="noopener"><img class="cover" src={driveImgWide(album.lead.id)} alt="" /></a>
    )}
    {chunks.map((chunk, n) => (<>
    <div class="collage">
      {chunk.map((p) => (
        <div class="cell" style={`--r:${p.ratio.toFixed(3)}`}>
          {p.video ? (
            <button class="item video" data-src={p.src} data-embed={p.embed} aria-label="영상 재생">
              <img class="cover" src={p.thumb} alt="" loading="lazy" /><span class="play" aria-hidden="true"></span>
            </button>
          ) : (
            <a class:list={['item', { ph: !p.thumb, photo: !!p.src }]} href={p.src || undefined} target="_blank" rel="noopener">
              {p.thumb && <img class="cover" src={p.thumb} alt="" loading="lazy" />}
            </a>
          )}
        </div>
      ))}
    </div>
    {after[n]?.length > 0 && <div class="between"><Paragraphs paras={after[n]} /></div>}
    </>))}
  </section>

  <dialog class="player" aria-label="영상">
    <button class="close" aria-label="닫기">×</button>
    <div class="frame"><video controls playsinline></video><iframe title="앨범 영상" allow="autoplay; fullscreen" allowfullscreen hidden></iframe></div>
  </dialog>

  <dialog class="viewer" aria-label="사진 크게 보기">
    <img alt="" />
    <button class="nav prev" aria-label="이전 사진">‹</button>
    <button class="nav next" aria-label="다음 사진">›</button>
    <span class="count"></span>
  </dialog>
</Base>

<script>
  // 누르면 영상 파일을 바로 재생하고, 불러오지 못하면 드라이브 플레이어로 바꾼다.
  const dialog = document.querySelector<HTMLDialogElement>('dialog.player')!;
  const video = dialog.querySelector('video')!;
  const frame = dialog.querySelector('iframe')!;
  let embed = '';
  const useEmbed = () => {
    if (!embed || !frame.hidden) return;
    video.pause();
    video.hidden = true;
    frame.hidden = false;
    frame.src = embed;
  };
  video.addEventListener('error', useEmbed);
  document.querySelectorAll<HTMLButtonElement>('.item.video').forEach((b) =>
    b.addEventListener('click', () => {
      embed = b.dataset.embed ?? '';
      frame.hidden = true;
      video.hidden = false;
      video.src = b.dataset.src!;
      dialog.showModal();
      video.play().catch(() => {});
    }),
  );
  const close = () => dialog.close();
  dialog.querySelector('.close')!.addEventListener('click', close);
  dialog.addEventListener('click', (e) => { if (e.target === dialog) close(); });
  dialog.addEventListener('close', () => {
    video.pause();
    video.removeAttribute('src');
    video.load();
    frame.src = '';
  });

  // 사진 크게 보기: 좌우로 밀거나 화살표로 넘기고, 사진을 한 번 더 누르면 닫는다.
  const viewer = document.querySelector<HTMLDialogElement>('dialog.viewer')!;
  const img = viewer.querySelector('img')!;
  const count = viewer.querySelector('.count')!;
  const photos = [...document.querySelectorAll<HTMLAnchorElement>('a.photo')].map((a) => a.href);
  let at = 0;
  const show = (i: number) => {
    at = (i + photos.length) % photos.length;
    img.style.transform = '';
    img.src = photos[at];
    count.textContent = `${at + 1} / ${photos.length}`;
    // 옆 사진을 미리 받아 두어 넘길 때 바로 보이게 한다
    for (const d of [1, -1]) new Image().src = photos[(at + d + photos.length) % photos.length];
  };
  document.querySelectorAll<HTMLAnchorElement>('a.photo').forEach((a, i) =>
    a.addEventListener('click', (e) => {
      e.preventDefault();
      show(i);
      viewer.showModal();
    }),
  );
  viewer.querySelector('.prev')!.addEventListener('click', () => show(at - 1));
  viewer.querySelector('.next')!.addEventListener('click', () => show(at + 1));
  viewer.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowLeft') show(at - 1);
    if (e.key === 'ArrowRight') show(at + 1);
  });
  let startX: number | null = null;
  viewer.addEventListener('pointerdown', (e) => {
    if ((e.target as Element).closest('.nav')) return;
    startX = e.clientX;
  });
  viewer.addEventListener('pointermove', (e) => {
    if (startX !== null) img.style.transform = `translateX(${e.clientX - startX}px)`;
  });
  viewer.addEventListener('pointerup', (e) => {
    if (startX === null) return;
    const dx = e.clientX - startX;
    startX = null;
    if (Math.abs(dx) > 50 && photos.length > 1) show(dx < 0 ? at + 1 : at - 1);
    else if (Math.abs(dx) < 10) viewer.close();
    else img.style.transform = '';
  });
  viewer.addEventListener('pointercancel', () => { startX = null; img.style.transform = ''; });
</script>

<style>
  .head { padding-top: 64px; padding-bottom: 40px; }
  .back { font-size: 14px; color: var(--muted); }
  .date { display: block; margin-top: 40px; color: var(--gold); }
  h1 { font-family: var(--head); font-size: 48px; font-weight: 800; margin-top: 10px; letter-spacing: -.02em; }
  .between { padding: 48px 0 56px; }
  .between :global(.text) { margin-top: 0; }
  .gallery { padding-bottom: 110px; }
  .item { display: block; width: 100%; height: 100%; position: relative; border: 0; padding: 0; background: #eee; cursor: pointer; overflow: hidden; }
  .item img { transition: transform .4s; }
  .item:hover img { transform: scale(1.03); }
  .lead { aspect-ratio: 16/9; margin-bottom: 8px; }
  /* 행 높이를 맞춘 콜라주: 칸 너비를 사진 비율에 비례해 늘린다 */
  .collage { display: flex; flex-wrap: wrap; gap: 8px; }
  .collage + .collage { margin-top: 8px; }
  .collage::after { content: ''; flex-grow: 999; }
  .cell { flex-grow: calc(var(--r) * 100); width: calc(var(--r) * 260px); aspect-ratio: var(--r); max-height: 520px; }
  .play { position: absolute; left: 50%; top: 50%; width: 64px; height: 64px; margin: -32px 0 0 -32px; border-radius: 50%; background: rgba(0, 0, 0, .55); }
  .play::after { content: ''; position: absolute; left: 26px; top: 20px; border-left: 18px solid #fff; border-top: 12px solid transparent; border-bottom: 12px solid transparent; }
  .video:hover .play { background: var(--gold); }
  .player { border: 0; padding: 0; background: transparent; width: min(1000px, 92vw); max-height: 92vh; overflow: visible; }
  .player::backdrop { background: rgba(0, 0, 0, .85); }
  .frame { aspect-ratio: 16/9; background: #000; }
  .frame iframe, .frame video { width: 100%; height: 100%; border: 0; display: block; }
  .frame [hidden] { display: none; }
  .close { position: absolute; top: -44px; right: 0; background: none; border: 0; color: #fff; font-size: 36px; line-height: 1; cursor: pointer; }
  .viewer { border: 0; padding: 0; margin: 0; width: 100vw; height: 100vh; max-width: none; max-height: none; background: rgba(0, 0, 0, .94); touch-action: pan-y; user-select: none; }
  .viewer[open] { display: flex; align-items: center; justify-content: center; }
  .viewer::backdrop { background: transparent; }
  .viewer img { max-width: 100%; max-height: 100%; object-fit: contain; cursor: zoom-out; -webkit-user-drag: none; pointer-events: none; }
  .nav { position: absolute; top: 50%; width: 56px; height: 56px; margin-top: -28px; border: 0; border-radius: 50%; background: rgba(255, 255, 255, .12); color: #fff; font-size: 34px; line-height: 1; cursor: pointer; }
  .nav:hover { background: var(--gold); }
  .prev { left: 24px; }
  .next { right: 24px; }
  .count { position: absolute; bottom: 24px; left: 0; right: 0; text-align: center; color: rgba(255, 255, 255, .7); font-size: 14px; letter-spacing: .05em; }
  @media (max-width: 760px) {
    .nav { display: none; }
    .head { padding-top: 32px; }
    h1 { font-size: 30px; }
    .gallery { padding-bottom: 72px; margin: 0; padding-left: 0; padding-right: 0; }
    .lead { aspect-ratio: 4/3; margin-bottom: 4px; }
    .collage { gap: 4px; }
    .collage + .collage { margin-top: 4px; }
    .between { padding: 32px var(--gutter) 40px; }
    .cell { width: calc(var(--r) * 150px); }
    .play { width: 48px; height: 48px; margin: -24px 0 0 -24px; }
    .play::after { left: 19px; top: 14px; border-left-width: 14px; border-top-width: 10px; border-bottom-width: 10px; }
  }
</style>
