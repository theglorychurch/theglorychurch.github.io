---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import { nav, vision } from '../../data/church';
---
<Base title="비전">
  <PageHead eyebrow="About" title="교회안내" sub={nav[0].items} />

  <section class="sec">
    <div class="wrap">
      <span class="eyebrow gold">Our Vision</span>
      <h2 class="statement">{vision.title.split('\n').map((l) => <>{l}<br /></>)}</h2>
      <figure class="verse">
        <blockquote>“{vision.verse}”</blockquote>
        <figcaption>{vision.verseRef}</figcaption>
      </figure>
    </div>
  </section>

  <section class="sec pillars-sec">
    <div class="wrap">
      {vision.pillars.map((p, i) => (
        <article class="pillar">
          <span class="no">0{i + 1}</span>
          <div>
            <span class="eyebrow gold">{p.en} · {p.person}</span>
            <h3>그 영광(The Glory),<br />{p.title}</h3>
          </div>
          <p>{p.body}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="sec about">
    <div class="wrap"><p>{vision.about}</p></div>
  </section>
</Base>

<style>
  .gold { color: var(--gold); }
  .statement { font-family: var(--head); font-size: 52px; font-weight: 800; line-height: 1.3; letter-spacing: -.03em; margin-top: 18px; }
  .verse { margin-top: 56px; padding-left: 28px; border-left: 2px solid var(--gold); max-width: 760px; }
  .verse blockquote { font-size: 18px; line-height: 1.9; color: #333; }
  .verse figcaption { margin-top: 12px; font-weight: 700; font-size: 14px; }
  .pillars-sec { background: var(--paper-2); }
  .pillar { display: grid; grid-template-columns: 120px 1fr 1.2fr; gap: 40px; padding: 44px 0; border-top: 1px solid var(--rule); align-items: start; }
  .pillar:last-child { border-bottom: 1px solid var(--rule); }
  .no { font-family: var(--head); font-weight: 300; font-size: 56px; line-height: 1; }
  .pillar h3 { font-family: var(--head); font-size: 28px; font-weight: 700; margin-top: 10px; line-height: 1.35; }
  .pillar p { font-size: 17px; line-height: 1.9; color: #444; }
  .about p { font-family: var(--head); font-size: 26px; line-height: 1.7; font-weight: 500; max-width: 900px; }
  @media (max-width: 760px) {
    .statement { font-size: 30px; }
    .verse { margin-top: 36px; padding-left: 18px; }
    .verse blockquote { font-size: 16px; }
    .pillar { grid-template-columns: 1fr; gap: 14px; padding: 32px 0; }
    .no { font-size: 40px; }
    .pillar h3 { font-size: 22px; }
    .pillar p { font-size: 16px; }
    .about p { font-size: 19px; }
  }
</style>
