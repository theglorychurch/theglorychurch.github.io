---
import Base from '../layouts/Base.astro';
import { church, worship, newcomer } from '../data/church';
const sunday = worship.main[0];
const showTodo = import.meta.env.DEV || import.meta.env.SHOW_TODO === '1';
---
<Base title="새가족안내" description={`${church.name}에 처음 오시는 분을 위한 안내입니다.`}>
  <header class="intro">
    <div class="wrap">
      <span class="eyebrow">Welcome</span>
      <h1>처음 오셨나요?<br />환영합니다.</h1>
      <p>교회가 처음이어도, 오랜만이어도 괜찮아요.<br />{church.name}에 오시면 이렇게 안내해 드려요.</p>
      <div class="when">
        <div><span>{sunday.name}</span><b>{sunday.day} 오전 {sunday.time}</b></div>
        <div><span>장소</span><b>{church.address}</b></div>
        <a class="btn solid" href="/about/location/">오시는 길 →</a>
      </div>
    </div>
  </header>

  <section class="sec">
    <div class="wrap">
      <div class="sec-head"><div><span class="eyebrow">Your First Sunday</span><h2>첫 주일은 이렇게 흘러가요</h2></div></div>
      <ol class="flow">
        {newcomer.steps.map((s, i) => (
          <li class:list={{ todo: showTodo && s.confirm }}>
            <span class="no">{String(i + 1).padStart(2, '0')}</span>
            <div><h3>{s.t}</h3><p>{s.d}{s.more && <><br />{s.more}</>}</p></div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="sec faq-sec">
    <div class="wrap">
      <div class="sec-head"><div><span class="eyebrow">FAQ</span><h2>이런 게 궁금하실 수 있어요</h2></div></div>
      <div class="faq">
        {newcomer.faq.map((f, i) => (
          <details class:list={{ todo: showTodo && f.confirm }} open={i === 0}>
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="sec">
    <div class="wrap cta">
      <div>
        <span class="eyebrow">Contact</span>
        <h2>오시기 전에 궁금한 점이 있으신가요?</h2>
        <p>전화 주시면 친절히 안내해 드릴게요. 미리 연락하지 않고 오셔도 괜찮습니다.</p>
      </div>
      <div class="btns">
        <a class="btn solid" href={church.phoneHref}>{church.phone}</a>
        <a class="btn" href={church.youtube} target="_blank" rel="noopener">설교 미리 보기 ↗</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .intro { background: var(--ink); color: var(--paper); padding: 96px 0 80px; }
  .intro .eyebrow { color: var(--gold-2); }
  .intro h1 { font-family: var(--head); font-size: 72px; font-weight: 800; line-height: 1.15; letter-spacing: -.03em; margin-top: 16px; }
  .intro p { margin-top: 24px; font-size: 18px; line-height: 1.8; color: #ccc; }
  .when { margin-top: 56px; padding-top: 28px; border-top: 1px solid #333; display: flex; gap: 48px; align-items: flex-end; flex-wrap: wrap; }
  .when span { display: block; font-size: 13px; color: #999; margin-bottom: 6px; }
  .when b { font-family: var(--head); font-size: 24px; font-weight: 700; }
  .when .btn { margin-left: auto; background: var(--gold-2); border-color: var(--gold-2); color: var(--ink); }

  .flow { list-style: none; display: grid; grid-template-columns: repeat(3, 1fr); gap: 0 40px; }
  .flow li { display: grid; grid-template-columns: 56px 1fr; gap: 16px; padding: 32px 0; border-bottom: 1px solid var(--hair); }
  .flow .no { font-family: var(--head); font-weight: 300; font-size: 36px; line-height: 1; }
  .flow h3 { font-family: var(--head); font-size: 21px; font-weight: 800; margin-bottom: 10px; }
  .flow p { line-height: 1.8; color: #444; font-size: 15px; }

  .faq-sec { background: var(--paper-2); }
  .faq { display: grid; grid-template-columns: 1fr 1fr; gap: 0 48px; }
  details { border-bottom: 1px solid var(--rule); padding: 22px 0; }
  summary { font-family: var(--head); font-size: 19px; font-weight: 700; cursor: pointer; list-style: none; display: flex; justify-content: space-between; gap: 16px; }
  summary::after { content: '+'; font-weight: 300; font-size: 24px; line-height: 1; }
  details[open] summary::after { content: '−'; }
  details p { margin-top: 12px; line-height: 1.8; color: #444; }

  .cta { display: flex; justify-content: space-between; align-items: flex-end; gap: 32px; flex-wrap: wrap; }
  .cta .eyebrow { color: var(--gold); }
  .cta h2 { font-family: var(--head); font-size: 34px; font-weight: 800; margin: 10px 0 12px; }
  .cta p { color: #555; }
  .btns { display: flex; gap: 10px; flex-wrap: wrap; }

  /* 사실 확인이 필요한 초안 표시 (개발 화면에서만) */
  .todo { outline: 2px dashed var(--gold-2); outline-offset: 4px; position: relative; }
  .todo::before { content: '확인 필요'; position: absolute; top: 6px; right: 0; font-size: 10px; font-weight: 800; background: var(--gold-2); padding: 2px 6px; }

  @media (max-width: 760px) {
    .intro { padding: 56px 0 48px; }
    .intro h1 { font-size: 40px; }
    .intro p { font-size: 16px; }
    .when { gap: 20px; margin-top: 36px; flex-direction: column; align-items: flex-start; }
    .when b { font-size: 19px; }
    .when .btn { margin-left: 0; }
    .flow { grid-template-columns: 1fr; }
    .flow li { grid-template-columns: 44px 1fr; padding: 24px 0; }
    .flow .no { font-size: 28px; }
    .faq { grid-template-columns: 1fr; }
    summary { font-size: 17px; }
    .cta h2 { font-size: 24px; }
  }
</style>
