---
import Base from '../../../layouts/Base.astro';
import { getContent, fmtFull, videoFor, type Note } from '../../../lib/content';

export async function getStaticPaths() {
  const { notes, videos } = await getContent();
  return notes.map((note, i) => ({
    params: { id: note.id },
    props: {
      note,
      prev: notes[i + 1],
      next: notes[i - 1],
      video: videoFor(note, videos),
    },
  }));
}

interface Props { note: Note; prev?: Note; next?: Note; video?: { url: string } }
const { note, prev, next, video } = Astro.props;
---
<Base title={note.title} description={[note.ref, note.verse || note.body.find((b) => b.kind === 'p')?.text.slice(0, 120)].filter(Boolean).join(' · ')}>
  <article class="wrap note">
    <a class="back" href="/sermons/notes/">← 설교요약 & 기도</a>
    <span class="eyebrow date">{fmtFull(note.date)} 주일</span>
    <h1>{note.title}</h1>
    {note.ref && (
      <figure class="passage">
        <figcaption>{note.ref}</figcaption>
        {note.verse && <blockquote>{note.verse}</blockquote>}
      </figure>
    )}
    <div class="prose">
      {note.body.map((b) => b.kind === 'h' ? <h2 class="point">{b.text}</h2> : <p>{b.text.split('\n').map((l, i) => <>{i > 0 && <br />}{l}</>)}</p>)}
    </div>
    {note.questions.length > 0 && (
      <section class="questions">
        <span class="eyebrow">Sharing</span>
        <h2>나눔 질문</h2>
        <ol>{note.questions.map((q) => <li>{q}</li>)}</ol>
      </section>
    )}
    {video && <a class="btn solid watch" href={video.url} target="_blank" rel="noopener">설교 영상 보기 ↗</a>}
    <nav class="pager">
      {prev ? <a href={`/sermons/notes/${prev.id}/`}><small>이전</small>{prev.title}</a> : <span></span>}
      {next && <a class="r" href={`/sermons/notes/${next.id}/`}><small>다음</small>{next.title}</a>}
    </nav>
  </article>
</Base>

<style>
  .note { max-width: 820px; padding-top: 64px; padding-bottom: 110px; }
  .back { font-size: 14px; color: var(--muted); }
  .date { display: block; margin-top: 48px; color: var(--gold); }
  h1 { font-family: var(--head); font-size: 48px; font-weight: 800; line-height: 1.3; letter-spacing: -.02em; margin-top: 12px; }
  .passage { margin: 40px 0 56px; background: var(--ink); color: var(--paper); padding: 36px 40px; }
  .passage figcaption { font-weight: 700; color: var(--gold-2); font-size: 14px; letter-spacing: .05em; }
  .passage blockquote { font-family: var(--head); font-size: 24px; line-height: 1.7; font-weight: 500; margin-top: 12px; }
  .point { font-family: var(--head); font-size: 22px; font-weight: 700; line-height: 1.5; margin: 48px 0 14px; }
  .questions { margin-top: 64px; background: var(--paper-2); padding: 36px 40px; }
  .questions .eyebrow { color: var(--gold); }
  .questions h2 { font-family: var(--head); font-size: 24px; font-weight: 800; margin: 8px 0 20px; }
  .questions ol { padding-left: 1.3em; display: grid; gap: 14px; }
  .questions li { font-size: 16px; line-height: 1.8; }
  .questions li::marker { font-family: var(--head); font-weight: 700; color: var(--gold); }
  .watch { margin-top: 48px; }
  .pager { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 72px; border-top: 1px solid var(--rule); padding-top: 24px; }
  .pager a { font-family: var(--head); font-weight: 600; font-size: 16px; line-height: 1.5; }
  .pager small { display: block; font-family: Pretendard, sans-serif; color: var(--muted); font-size: 12px; margin-bottom: 4px; }
  .pager .r { text-align: right; }
  @media (max-width: 760px) {
    .note { padding-top: 32px; padding-bottom: 72px; }
    .date { margin-top: 32px; }
    h1 { font-size: 30px; }
    .passage { margin: 28px calc(-1 * var(--gutter)) 40px; padding: 28px var(--gutter); }
    .passage blockquote { font-size: 19px; }
    .point { font-size: 19px; }
    .questions { margin: 48px calc(-1 * var(--gutter)) 0; padding: 28px var(--gutter); }
  }
</style>
