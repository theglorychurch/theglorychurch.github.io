---
import '../styles/global.css';
import { church, nav } from '../data/church';
import { getContent } from '../lib/content';
import TheGlory from '../assets/script/the-glory-church.svg?raw';

interface Props { title?: string; description?: string }
const { title, description = `${church.denomination} ${church.name} · 영광에서 영광으로 변화되어, 하나님의 영광을 반사하는 공동체` } = Astro.props;
const fullTitle = title ? `${title} | ${church.name}` : church.name;
const { badges, notice } = await getContent();
const path = Astro.url.pathname;
const isActive = (href: string, items: readonly { href: string }[]) =>
  items.some((i) => path.startsWith(i.href)) || path.startsWith(href);
---
<!doctype html>
<html lang="ko">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content="/img/og.png" />
  <meta property="og:type" content="website" />
  <link rel="icon" href="/favicon.ico" />
  <link rel="apple-touch-icon" href="/img/favicon.png" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/pretendard@1.3.9/dist/web/static/pretendard.css" />
</head>
<body>
  {notice && (
    <div class="notice" role="status">
      {notice.link
        ? <a class="wrap" href={notice.link}><span class="label">공지</span><span class="text">{notice.text}</span><span class="go">→</span></a>
        : <div class="wrap"><span class="label">공지</span><span class="text">{notice.text}</span></div>}
    </div>
  )}
  <header class="site-header">
    <div class="wrap bar">
      <a class="logo" href="/" aria-label={`${church.name} 홈`}><img src="/img/logo.png" alt={church.name} /></a>
      <nav class="gnb" aria-label="주 메뉴">
        {nav.map((m) => {
          const count = 'badge' in m ? badges[m.badge] : 0;
          return (
            <div class="menu">
              <a href={m.href} class:list={{ on: isActive(m.href, m.items) }}>
                {m.label}{count > 0 && <span class="badge" aria-label={`새 글 ${count}개`}>{count}</span>}
              </a>
              <ul class="drop">{m.items.map((i) => <li><a href={i.href}>{i.label}</a></li>)}</ul>
            </div>
          );
        })}
      </nav>
      <div class="sns">
        <a href={church.youtube} target="_blank" rel="noopener">YOUTUBE</a>
        {church.instagram && <a href={church.instagram} target="_blank" rel="noopener">INSTAGRAM</a>}
      </div>
      <button class="burger" aria-label="전체 메뉴" aria-expanded="false" aria-controls="allmenu"><i></i><i></i><i></i></button>
    </div>
    <div class="allmenu" id="allmenu" hidden>
      <div class="wrap">
        {nav.map((m) => (
          <div class="group">
            <strong>{m.label}</strong>
            <ul>{m.items.map((i) => <li><a href={i.href}>{i.label}</a></li>)}</ul>
          </div>
        ))}
      </div>
    </div>
  </header>

  <main><slot /></main>

  <footer class="site-footer">
    <div class="wrap">
      <div class="script-svg sign" set:html={TheGlory} />
      <div class="row">
        <div><b>{church.denomination} {church.name}</b><br />{church.address}<br /><a href={church.phoneHref}>{church.phone}</a></div>
        <div class="links">
          <a href={church.youtube} target="_blank" rel="noopener">YouTube ↗</a>
          {church.instagram && <a href={church.instagram} target="_blank" rel="noopener">Instagram ↗</a>}
          <span>© {new Date().getFullYear()} {church.nameEn}</span>
        </div>
      </div>
    </div>
  </footer>

  <script>
    const btn = document.querySelector<HTMLButtonElement>('.burger')!;
    const panel = document.getElementById('allmenu')!;
    btn.addEventListener('click', () => {
      const open = btn.getAttribute('aria-expanded') !== 'true';
      btn.setAttribute('aria-expanded', String(open));
      panel.hidden = !open;
      document.body.classList.toggle('menu-open', open);
    });
  </script>
</body>
</html>

<style>
  .notice { background: var(--gold-2); color: var(--ink); font-size: 14px; font-weight: 600; }
  .notice .wrap { display: flex; align-items: center; gap: 12px; min-height: 44px; padding-top: 10px; padding-bottom: 10px; }
  .notice .label { font-size: 11px; font-weight: 800; letter-spacing: .1em; background: var(--ink); color: var(--gold-2); padding: 3px 8px; flex: none; }
  .notice .text { line-height: 1.45; }
  .notice .go { margin-left: auto; flex: none; }
  .notice a:hover .text { text-decoration: underline; }
  .site-header { border-bottom: 1px solid var(--rule); background: var(--paper); position: sticky; top: 0; z-index: 20; }
  .bar { display: flex; align-items: center; justify-content: space-between; height: 92px; }
  .logo img { height: 64px; filter: brightness(0); }
  .gnb { display: flex; gap: 44px; font-family: var(--head); font-size: 15px; font-weight: 600; height: 100%; }
  .menu { position: relative; display: flex; align-items: center; }
  .menu > a { position: relative; padding: 8px 0; }
  .menu > a.on::after, .menu:hover > a::after { content: ''; position: absolute; left: 0; right: 0; bottom: 0; height: 1.5px; background: var(--ink); }
  .badge { position: absolute; top: -4px; right: -18px; min-width: 17px; height: 17px; padding: 0 5px; border-radius: 9px; background: var(--gold-2); color: var(--ink); font-family: Pretendard, sans-serif; font-size: 10px; font-weight: 800; line-height: 17px; text-align: center; }
  .drop { position: absolute; top: 100%; left: 50%; transform: translateX(-50%); min-width: 160px; background: var(--paper); border: 1px solid var(--rule); padding: 10px 0; opacity: 0; visibility: hidden; transition: opacity .15s; }
  .menu:hover .drop, .menu:focus-within .drop { opacity: 1; visibility: visible; }
  .drop a { display: block; padding: 9px 20px; font-size: 14px; font-weight: 500; white-space: nowrap; }
  .drop a:hover { background: var(--paper-2); }
  .sns { display: flex; gap: 18px; font-size: 12px; font-weight: 600; letter-spacing: .1em; }
  .burger { display: none; background: none; border: 0; width: 24px; height: 14px; flex-direction: column; justify-content: space-between; cursor: pointer; }
  .burger i { height: 1.5px; background: var(--ink); transition: transform .2s, opacity .2s; }
  .burger[aria-expanded='true'] i:nth-child(1) { transform: translateY(6.25px) rotate(45deg); }
  .burger[aria-expanded='true'] i:nth-child(2) { opacity: 0; }
  .burger[aria-expanded='true'] i:nth-child(3) { transform: translateY(-6.25px) rotate(-45deg); }
  .allmenu { border-top: 1px solid var(--hair); background: var(--paper); height: calc(100dvh - 120px); overflow-y: auto; }
  .allmenu .wrap { display: grid; gap: 28px; padding-top: 28px; padding-bottom: 40px; }
  .allmenu strong { font-family: var(--head); font-size: 22px; font-weight: 800; display: block; border-bottom: 1px solid var(--rule); padding-bottom: 10px; margin-bottom: 6px; }
  .allmenu li a { display: block; padding: 10px 0; font-size: 16px; }

  .site-footer { background: var(--ink); color: #bbb; padding: 90px 0 60px; }
  .sign { width: 600px; max-width: 80%; }
  .row { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 24px; margin-top: 40px; border-top: 1px solid #333; padding-top: 28px; font-size: 14px; line-height: 1.9; }
  .row b { color: #fff; }
  .links { display: flex; flex-direction: column; align-items: flex-end; }

  @media (max-width: 760px) {
    .bar { height: auto; flex-wrap: wrap; padding-top: 12px; }
    .logo img { height: 52px; }
    .sns { display: none; }
    .burger { display: flex; }
    .gnb { order: 3; width: 100%; justify-content: space-between; gap: 0; font-size: 14px; border-top: 1px solid var(--hair); margin-top: 10px; padding: 4px 0; height: auto; }
    .menu > a { padding: 8px 0; }
    .badge { right: -14px; top: -2px; }
    .drop { display: none; }
    .site-footer { padding: 64px 0 48px; }
    .sign { width: 300px; }
    .links { align-items: flex-start; }
  }
  @media (min-width: 761px) { .allmenu { display: none; } }
  :global(body.menu-open) { overflow: hidden; }
</style>
