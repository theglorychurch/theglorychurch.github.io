# 구글 클라우드 API 키 (YouTube Data API v3, Google Drive API 사용 설정)
GOOGLE_API_KEY=

# 구글 드라이브 폴더 ID (폴더 주소 drive.google.com/drive/folders/<여기> 부분)
DRIVE_NOTES_FOLDER=
DRIVE_BULLETIN_FOLDER=
DRIVE_ALBUM_FOLDER=
DRIVE_MAIN_FOLDER=

# 공지 한 줄 구글 문서 ID (문서 주소 docs.google.com/document/d/<여기>/edit)
DRIVE_NOTICE_DOC=

# 인스타그램: Meta 개발자 앱(Unified login)의 시스템 사용자 토큰(EAA..., 만료 없음)과 인스타 계정 ID
INSTAGRAM_TOKEN=
INSTAGRAM_USER_ID=17841473999051029
